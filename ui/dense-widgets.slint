import { ListView, LineEdit, VerticalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component SearchCombo inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: -1;
    in property <bool> enabled: true;
    in property <string> placeholder;
    in property <string> search-placeholder;
    in property <string> empty-text;
    callback filter([string], string) -> [int];
    callback selected(int);
    private property <string> query;
    private property <[int]> matches;
    private property <int> highlighted;
    private property <length> scroll-y;
    private property <length> options-height: min(224px, max(28px, root.matches.length * 28px));
    height: 32px; min-width: 160px;
    horizontal-stretch: 1; vertical-stretch: 0;
    border-radius: 3px; border-width: 1px;
    border-color: focus.has-focus ? Theme.focus : Theme.border;
    background: touch.has-hover && root.enabled ? Theme.hover : Theme.surface;
    forward-focus: focus;
    accessible-role: combobox; accessible-enabled: root.enabled;
    accessible-value: root.current-index >= 0 ? root.model[root.current-index] : "";
    accessible-expandable: true;
    accessible-action-expand => { if root.enabled { root.open(); } }
    function open() {
        root.query = ""; root.matches = root.filter(root.model, "");
        root.highlighted = max(0, root.current-index);
        root.scroll-y = -max(0, root.highlighted - 7) * 28px;
        popup.show();
    }
    function choose(index: int) {
        if root.enabled && index >= 0 && index < root.model.length {
            root.current-index = index; root.selected(index); popup.close(); focus.focus();
        }
    }
    Text {
        x: 10px; width: parent.width - 36px; height: 100%; font-size: 12px;
        text: root.current-index >= 0 ? root.model[root.current-index] : root.placeholder;
        color: root.current-index >= 0 ? Theme.text : Theme.muted;
        opacity: root.enabled ? 1 : 0.4; vertical-alignment: center; overflow: elide;
    }
    Image { x: parent.width - 22px; y: (parent.height - 10px) / 2; width: 10px; height: 10px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.text; opacity: root.enabled ? 1 : 0.4; }
    focus := FocusScope {
        width: 100%; height: 100%; enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow { root.open(); return accept; } return reject; }
        touch := TouchArea { clicked => { focus.focus(); root.open(); } }
    }
    popup := PopupWindow {
        x: 0px; y: root.height; width: root.width; height: root.options-height + 48px;
        close-policy: close-on-click-outside; forward-focus: search;
        Rectangle {
            border-radius: 3px; border-width: 1px; border-color: Theme.border; background: Theme.surface;
            VerticalBox {
                padding: 6px; spacing: 4px;
                search := LineEdit {
                    height: 32px; text <=> root.query; placeholder-text: root.search-placeholder;
                    edited => { root.matches = root.filter(root.model, root.query); root.highlighted = 0; root.scroll-y = 0px; }
                    accepted => { if root.matches.length > 0 { root.choose(root.matches[root.highlighted]); } }
                    key-pressed(event) => {
                        if event.text == Key.Escape { popup.close(); focus.focus(); return accept; }
                        if root.matches.length > 0 && (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                            root.highlighted = (root.highlighted + (event.text == Key.DownArrow ? 1 : -1)).clamp(0, root.matches.length - 1);
                            if root.highlighted * 28px + root.scroll-y < 0px { root.scroll-y = -root.highlighted * 28px; }
                            if (root.highlighted + 1) * 28px + root.scroll-y > root.options-height { root.scroll-y = root.options-height - (root.highlighted + 1) * 28px; }
                            return accept;
                        }
                        return reject;
                    }
                }
                Rectangle {
                    height: root.options-height;
                    ListView {
                        width: 100%; height: 100%; content-width: self.visible-width; content-y <=> root.scroll-y;
                        horizontal-scrollbar-policy: always-off;
                        for original[index] in root.matches: Rectangle {
                            height: 28px;
                            background: root.highlighted == index ? Theme.selected : row-touch.has-hover ? Theme.hover : Theme.surface;
                            accessible-role: list-item; accessible-label: root.model[original];
                            accessible-action-default => { root.choose(original); }
                            Text { x: 6px; width: parent.width - 12px; height: 100%; text: root.model[original]; font-size: 12px; color: Theme.text; vertical-alignment: center; overflow: elide; }
                            row-touch := TouchArea { moved => { root.highlighted = index; } clicked => { root.choose(original); } }
                        }
                    }
                    if root.matches.length == 0: Text { width: 100%; height: 100%; text: root.empty-text; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}

export component FadeScrollBar inherits Rectangle {
    in property <length> content-height;
    in-out property <length> value;
    private property <int> age: 1200;
    width: 10px;
    opacity: root.content-height > root.height && (root.age < 900 || touch.has-hover || touch.pressed) ? 1 : 0;
    animate opacity { duration: 200ms; }
    changed value => { root.age = 0; }
    Timer { interval: 50ms; running: root.age < 1200; triggered => { root.age += 50; } }
    thumb := Rectangle {
        x: 3px; width: 4px;
        height: min(parent.height, max(20px, parent.height * parent.height / max(1px, root.content-height)));
        y: -root.value / max(1px, root.content-height - root.height) * (parent.height - self.height);
        border-radius: 2px; background: Theme.muted;
    }
    FocusScope {
        width: 100%; height: 100%; enabled: root.content-height > root.height;
        accessible-role: slider;
        accessible-value: -root.value / 1px;
        accessible-value-minimum: 0;
        accessible-value-maximum: max(0px, root.content-height - root.height) / 1px;
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.value = min(0px, root.value + 22px); return accept; }
            if event.text == Key.DownArrow { root.value = max(min(0px, root.height - root.content-height), root.value - 22px); return accept; }
            return reject;
        }
        touch := TouchArea {
            private property <length> start-value;
            pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { self.start-value = root.value; } }
            moved => { if self.pressed { root.value = (self.start-value - (self.mouse-y - self.pressed-y) * (root.content-height - root.height) / max(1px, root.height - thumb.height)).clamp(min(0px, root.height - root.content-height), 0px); } }
            scroll-event(event) => { root.value = (root.value + event.delta-y).clamp(min(0px, root.height - root.content-height), 0px); return accept; }
        }
    }
}

export component DenseList inherits Rectangle {
    in property <bool> enabled: true;
    in property <[StandardListViewItem]> model;
    in property <[bool]> highlighted;
    in-out property <int> current-item: -1;
    callback current-item-changed(int);
    callback item-double-clicked(int);
    callback item-pointer-event(int, PointerEvent, Point);
    background: Theme.surface;
    clip: true;
    forward-focus: keys;
    function select(index: int) {
        let row = index.clamp(0, root.model.length - 1);
        if root.model.length > 0 && root.current-item != row {
            root.current-item = row;
            if row * 22px + list.content-y < 0px { list.content-y = -row * 22px; }
            if (row + 1) * 22px + list.content-y > list.visible-height { list.content-y = min(0px, list.visible-height - (row + 1) * 22px); }
            root.current-item-changed(row);
        }
    }
    keys := FocusScope {
        x: 0px; y: 0px; width: 100%; height: 100%;
        enabled: root.enabled;
        accessible-role: AccessibleRole.list;
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.select(root.current-item - 1); return accept; }
            if event.text == Key.DownArrow { root.select(root.current-item + 1); return accept; }
            if event.text == Key.Home { root.select(0); return accept; }
            if event.text == Key.End { root.select(root.model.length - 1); return accept; }
            return reject;
        }
        list := ListView {
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            for item[index] in root.model: Rectangle {
                height: 22px;
                background: root.current-item == index ? Theme.selected : touch.has-hover ? Theme.panel : Theme.surface;
                accessible-role: list-item;
                accessible-label: item.text;
                accessible-item-selected: root.current-item == index;
                accessible-action-default => { root.select(index); }
                Text { x: 5px; width: parent.width - 10px; height: parent.height; text: item.text; font-size: 12px; color: root.highlighted[index] ? Theme.focus : Theme.text; vertical-alignment: center; overflow: elide; }
                touch := TouchArea {
                    enabled: root.enabled;
                    clicked => { keys.focus(); root.select(index); }
                    double-clicked => { keys.focus(); root.select(index); root.item-double-clicked(index); }
                    pointer-event(event) => { root.item-pointer-event(index, event, { x: self.mouse-x, y: self.mouse-y + index * 22px + list.content-y }); }
                }
            }
        }
    }
    FadeScrollBar { x: parent.width - self.width; height: parent.height; content-height: list.content-height; value <=> list.content-y; }
}

export component DenseTable inherits Rectangle {
    in-out property <[TableColumn]> columns;
    in property <[[StandardListViewItem]]> rows;
    in-out property <int> current-row: -1;
    in property <bool> multi-select;
    in property <[bool]> selected-rows;
    in property <[bool]> selected-cells;
    in property <int> row-offset;
    in property <bool> sortable;
    in property <string> ascending-text;
    in property <string> descending-text;
    callback sort-column(int, bool);
    callback fit-column(int);
    private property <int> current-column: -1;
    callback row-selected(int, bool, bool);
    callback cell-selected(int, int, bool, bool);
    callback column-at(float) -> int;
    callback column-selected(int, bool);
    callback select-all();
    callback copy-selection();
    background: Theme.surface;
    clip: true;
    forward-focus: keys;
    function select(index: int, shift: bool, control: bool) {
        if root.rows.length == 0 { return; }
        root.current-row = index.clamp(0, root.rows.length - 1);
        root.current-column = -1;
        if root.multi-select { root.row-selected(root.current-row, shift, control); }
        if root.current-row * 22px + list.content-y < 0px { list.content-y = -root.current-row * 22px; }
        if (root.current-row + 1) * 22px + list.content-y > list.visible-height { list.content-y = min(0px, list.visible-height - (root.current-row + 1) * 22px); }
    }
    function select-cell(row: int, column: int, shift: bool, control: bool) {
        if root.rows.length == 0 || root.columns.length == 0 { return; }
        root.current-row = row.clamp(0, root.rows.length - 1);
        root.current-column = column.clamp(0, root.columns.length - 1);
        root.cell-selected(root.current-row, root.current-column, shift, control);
        if root.current-row * 22px + list.content-y < 0px { list.content-y = -root.current-row * 22px; }
        if (root.current-row + 1) * 22px + list.content-y > list.visible-height { list.content-y = min(0px, list.visible-height - (root.current-row + 1) * 22px); }
    }
    keys := FocusScope {
        x: 0px; y: 0px; width: 100%; height: 100%;
        accessible-role: table;
        key-pressed(event) => {
            if root.multi-select && event.modifiers.control && (event.text == "a" || event.text == "A") { root.select-all(); return accept; }
            if root.multi-select && event.modifiers.control && (event.text == "c" || event.text == "C") { root.copy-selection(); return accept; }
            if root.multi-select && root.current-column >= 0 {
                if event.text == Key.LeftArrow { root.select-cell(root.current-row, root.current-column - 1, event.modifiers.shift, event.modifiers.control); return accept; }
                if event.text == Key.RightArrow { root.select-cell(root.current-row, root.current-column + 1, event.modifiers.shift, event.modifiers.control); return accept; }
                if event.text == Key.UpArrow { root.select-cell(root.current-row - 1, root.current-column, event.modifiers.shift, event.modifiers.control); return accept; }
                if event.text == Key.DownArrow { root.select-cell(root.current-row + 1, root.current-column, event.modifiers.shift, event.modifiers.control); return accept; }
            }
            if event.text == Key.UpArrow { root.select(root.current-row - 1, event.modifiers.shift, event.modifiers.control); return accept; }
            if event.text == Key.DownArrow { root.select(root.current-row + 1, event.modifiers.shift, event.modifiers.control); return accept; }
            if event.text == Key.Home { root.select(0, event.modifiers.shift, event.modifiers.control); return accept; }
            if event.text == Key.End { root.select(root.rows.length - 1, event.modifiers.shift, event.modifiers.control); return accept; }
            return reject;
        }
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 24px;
                background: Theme.panel;
                clip: true;
                header := HorizontalLayout {
                    x: list.content-x; y: 0px;
                    width: list.content-width;
                    height: 24px;
                    spacing: 0px;
                    if root.multi-select: Rectangle {
                        width: 42px;
                        Text { text: "#"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    for column[index] in root.columns: Rectangle {
                        accessible-role: button;
                        accessible-label: column.title;
                        accessible-action-default => { if root.multi-select { root.column-selected(index, false); } }
                        width: column.width > 0px ? column.width : 160px;
                        clip: true;
                        Text { x: 5px; width: parent.width - (root.sortable ? 32px : 10px); height: parent.height; text: column.title; font-size: 12px; color: Theme.text; vertical-alignment: center; overflow: elide; }
                        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.table-border; }
                        header-touch := TouchArea {
                            width: parent.width - 5px;
                            enabled: root.multi-select;
                            pointer-event(event) => {
                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                    keys.focus(); root.current-row = 0; root.current-column = index;
                                    root.column-selected(index, event.modifiers.control);
                                }
                            }
                        }
                        TouchArea {
                            x: parent.width - 5px; width: 5px;
                            mouse-cursor: ew-resize;
                            double-clicked => { root.fit-column(index); }
                            moved => { if self.pressed { root.columns[index].width = max(60px, parent.width + self.mouse-x - self.pressed-x); } }
                        }
                        sort-menu := ContextMenuArea {
                            x: parent.width - 27px; y: 0px; width: 22px; height: 22px;
                            Menu {
                                MenuItem { title: root.ascending-text; enabled: root.sortable; activated => { root.sort-column(index, false); } }
                                MenuItem { title: root.descending-text; enabled: root.sortable; activated => { root.sort-column(index, true); } }
                            }
                            Rectangle {
                                width: 100%; height: 100%; visible: root.sortable;
                                border-radius: 3px;
                                background: sort-touch.has-hover || sort-focus.has-focus ? Theme.hover : transparent;
                                Image {
                                    visible: header-touch.has-hover || sort-touch.has-hover || sort-focus.has-focus;
                                    x: 6px; y: 6px; width: 10px; height: 10px;
                                    source: @image-url("icons/chevron-down.svg"); colorize: Theme.text;
                                }
                                sort-focus := FocusScope {
                                    width: 100%; height: 100%;
                                    enabled: root.sortable;
                                    accessible-role: button;
                                    accessible-label: column.title + " · " + root.ascending-text + " / " + root.descending-text;
                                    accessible-action-default => { sort-menu.show({x: 0px, y: 22px}); }
                                    key-pressed(event) => {
                                        if event.text == Key.Return || event.text == Key.Space { sort-menu.show({x: 0px, y: 22px}); return accept; }
                                        return reject;
                                    }
                                    sort-touch := TouchArea { clicked => { sort-focus.focus(); sort-menu.show({x: 0px, y: 22px}); } }
                                }
                            }
                        }
                    }
                }
            }
            list := ListView {
                vertical-stretch: 1;
                content-width: max(self.visible-width, header.preferred-width);
                for row[index] in root.rows: Rectangle {
                    height: 22px;
                    width: list.content-width;
                    background: (root.multi-select ? root.selected-rows[index] : root.current-row == index) ? Theme.selected : Math.mod(index, 2) == 0 ? Theme.surface : Theme.alternate;
                    accessible-role: list-item;
                    accessible-item-selected: root.multi-select ? root.selected-rows[index] : root.current-row == index;
                    accessible-action-default => { root.select(index, false, false); }
                    HorizontalLayout {
                        spacing: 0px;
                        if root.multi-select: Rectangle {
                            width: 42px; background: Theme.panel;
                            Text { text: root.row-offset + index + 1; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea {
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { keys.focus(); root.select(index, event.modifiers.shift, event.modifiers.control); }
                                }
                            }
                        }
                        for cell[column] in row: Rectangle {
                            width: root.columns[column].width > 0px ? root.columns[column].width : 160px;
                            clip: true;
                            background: root.selected-cells[index * root.columns.length + column] ? Theme.selected : transparent;
                            accessible-role: list-item;
                            accessible-label: root.columns[column].title + ": " + cell.text;
                            accessible-item-selected: root.selected-cells[index * root.columns.length + column] || root.selected-rows[index];
                            Text { x: 5px; width: parent.width - 10px; height: parent.height; text: cell.text; font-size: 12px; color: Theme.text; vertical-alignment: center; overflow: elide; }
                            TouchArea {
                                moved => {
                                    if self.pressed && root.multi-select {
                                        let x = parent.x + self.mouse-x + list.content-x;
                                        if x < 0px { list.content-x = min(0px, list.content-x - x); }
                                        if x > list.visible-width { list.content-x = max(min(0px, list.visible-width - list.content-width), list.content-x - (x - list.visible-width)); }
                                        root.select-cell(index + floor(self.mouse-y / 22px), root.column-at((parent.x + self.mouse-x) / 1px), true, false);
                                    }
                                }
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        keys.focus();
                                        if root.multi-select { root.select-cell(index, column, event.modifiers.shift, event.modifiers.control); }
                                        else { root.select(index, false, false); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
