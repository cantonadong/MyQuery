import { Button, CheckBox, ComboBox, LineEdit, TextEdit, StandardListView, StandardTableView, VerticalBox, HorizontalBox, TabWidget, ScrollView, ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
import { SqlEditor, SqlRun, SearchMatch } from "sql-editor.slint";
export { SqlRun, SearchMatch } from "sql-editor.slint";
import { DenseList, DenseTable, FadeScrollBar, SearchCombo } from "dense-widgets.slint";

export struct DbObject { name: string, kind: int }
export struct SqlTab { id: int, title: string, dirty: bool }
export struct BrowserScope { profile: string, database: string, schema: string }
export struct ScopeChoice { profile: string, database: string, schema: string, selected: bool }
export struct FieldRow { name: string, datatype: string, added: bool }

export global I18n {
    in-out property <bool> zh: true;
    public pure function t(zh: string, en: string) -> string { return self.zh ? zh : en; }
}

component Caption inherits Text {
    color: Theme.muted;
    font-size: 12px;
    vertical-alignment: center;
}

component CompactButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    callback clicked();
    height: 24px;
    width: max(48px, label.preferred-width + 24px);
    horizontal-stretch: 0;
    forward-focus: button;
    label := Text { visible: false; text: root.text; font-size: 12px; }
    button := Button {
        width: 100%; height: 100%;
        text: root.text; enabled: root.enabled; primary: root.primary;
        clicked => { root.clicked(); }
    }
}

component ObjectTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <bool> tab-style;
    callback clicked();
    height: 24px;
    min-width: 0px;
    horizontal-stretch: 1;
    border-radius: 4px;
    border-bottom-left-radius: root.tab-style ? 0px : 4px;
    border-bottom-right-radius: root.tab-style ? 0px : 4px;
    border-width: 1px;
    border-color: root.selected ? Theme.selected-border : Theme.border;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : Theme.window;
    if root.tab-style: Rectangle { x: 1px; y: parent.height - 1px; width: parent.width - 2px; height: 1px; background: parent.background; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Text { x: 4px; width: parent.width - 8px; height: parent.height; text: root.text; color: Theme.heading; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    focus := FocusScope {
        x: 0px; y: 0px; width: 100%; height: 100%;
        enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; } return reject; }
        touch := TouchArea { clicked => { focus.focus(); root.clicked(); } }
    }
}

component LoadingIndicator inherits Rectangle {
    width: 18px; height: 24px; horizontal-stretch: 0;
    ring := Path {
        y: 3px; width: 18px; height: 18px; viewbox-width: 18; viewbox-height: 18;
        private property <angle> spin: mod(animation-tick(), 2400ms) / 2400ms * 360deg;
        stroke: Theme.focus; stroke-width: 2px; fill: transparent;
        MoveTo { x: 9 + 7 * cos(ring.spin); y: 9 + 7 * sin(ring.spin); }
        ArcTo { radius-x: 7; radius-y: 7; x: 9 + 7 * cos(ring.spin + 270deg); y: 9 + 7 * sin(ring.spin + 270deg); large-arc: true; sweep: true; }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> framed;
    in property <length> icon-size: 16px;
    in property <bool> enabled: true;
    in property <brush> tint: Theme.heading;
    callback clicked();
    width: root.text == "" ? 24px : max(56px, button-label.preferred-width + 36px); height: 24px;
    border-radius: 3px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.focus : root.framed || (touch.has-hover && root.enabled) ? Theme.border : transparent;
    background: touch.has-hover && root.enabled ? Theme.hover : root.framed ? Theme.surface : transparent;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image { x: root.text == "" ? (parent.width - self.width) / 2 : 8px; y: (parent.height - self.height) / 2; width: root.icon-size; height: root.icon-size; source: root.icon; image-fit: contain; colorize: Theme.dark ? root.tint : transparent; opacity: root.enabled ? 1 : 0.4; }
    button-label := Text { visible: root.text != ""; x: 28px; width: self.preferred-width; height: parent.height; text: root.text; font-size: 12px; color: Theme.heading; opacity: root.enabled ? 1 : 0.4; vertical-alignment: center; }
    focus := FocusScope {
        x: 0px; y: 0px; width: 100%; height: 100%; enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; } return reject; }
        touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
    }
}

export component AppWindow inherits Window {
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    out property <string> window-title: "SQL Desk";
    title: root.window-title;
    icon: @image-url("icons/app.png");
    preferred-width: 1280px; preferred-height: 850px;
    min-width: 1050px; min-height: 740px;
    background: Theme.window;
    default-font-family: "Microsoft YaHei UI"; default-font-size: 12px;
    in-out property <bool> busy;
    in-out property <bool> document-saving;
    in-out property <int> active-document;
    in-out property <int> query-document;
    in-out property <string> document-title;
    in-out property <bool> rename-sql-open;
    in-out property <int> rename-sql-index;
    in-out property <string> rename-sql-text;
    in-out property <bool> connected;
    in-out property <bool> failed;
    in-out property <string> status;
    in-out property <string> connection-label;
    in-out property <[string]> profiles;
    in-out property <[string]> visible-profiles;
    in-out property <[BrowserScope]> browser-scopes;
    in-out property <bool> scopes-open;
    in-out property <[ScopeChoice]> scope-profiles;
    in-out property <[ScopeChoice]> scope-databases;
    in-out property <[ScopeChoice]> scope-schemas;
    in-out property <[string]> table-prefixes;
    in-out property <[string]> prefix-options;
    in-out property <string> active-prefix;
    in-out property <int> prefix-index;
    in-out property <int> profile-index: -1;
    in-out property <int> physical-index: -1;
    in-out property <string> profile-name;
    in-out property <int> engine;
    in-out property <string> host;
    in-out property <string> port: "5432";
    in-out property <string> database;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> tls: true;
    in-out property <bool> trust-server-certificate;
    in-out property <[string]> databases;
    in-out property <int> database-index: -1;
    in-out property <[string]> schemas;
    in-out property <string> schema;
    in-out property <int> schema-index: -1;
    in-out property <[StandardListViewItem]> tables;
    in-out property <[string]> changed-tables;
    in-out property <[bool]> table-changes;
    in-out property <[DbObject]> objects;
    in-out property <int> object-kind;
    in-out property <string> object-search;
    in-out property <int> table-count;
    in-out property <int> view-count;
    in-out property <int> mv-count;
    in-out property <[StandardListViewItem]> fields;
    in-out property <[FieldRow]> field-details;
    in-out property <bool> fields-loading;
    in-out property <bool> field-panel-hidden;
    in-out property <string> fields-loading-name;
    changed fields => { if root.fields.length == 0 { root.field-details = []; } }
    in-out property <int> table-index: -1;
    in-out property <string> sql;
    in-out property <[[SqlRun]]> sql-lines;
    in-out property <string> highlighted-sql;
    callback highlight(string);
    in-out property <[SqlTab]> sql-tabs;
    in-out property <int> active-sql;
    in-out property <bool> save-prompt-open;
    in-out property <string> save-prompt-title;
    in-out property <bool> config-open;
    in-out property <bool> timeout-open;
    private property <length> sidebar-width: 330px;
    private property <float> split-ratio: 0.5;
    private property <float> field-ratio: 0.25;
    in-out property <bool> group-open;
    in-out property <string> object-title;
    in-out property <string> object-name;
    in-out property <[string]> field-names;
    in-out property <string> group-field;
    in-out property <string> group-search;
    in-out property <[StandardListViewItem]> group-fields;
    in-out property <int> group-index: -1;
    in-out property <string> toast-text;
    in-out property <int> toast-age: 3000;
    in-out property <int> timeout: 120;
    in-out property <string> timeout-input: "120";
    in-out property <[string]> scope-database-names;
    in-out property <[string]> scope-schema-names;
    in-out property <int> scope-profile-index: -1;
    in-out property <int> scope-database-index: -1;
    in-out property <int> scope-schema-index: -1;
    in-out property <[string]> result-names;
    in-out property <int> result-index: -1;
    in-out property <[TableColumn]> result-columns;
    in-out property <[[StandardListViewItem]]> result-rows;
    in-out property <int> page;
    in-out property <int> pages;
    in-out property <string> row-count: "0";
    in-out property <int> selected-row: -1;
    in-out property <[bool]> selected-rows;
    in-out property <[bool]> selected-cells;
    in-out property <int> cell-anchor-column: -1;
    in-out property <int> selected-count;
    in-out property <int> selection-anchor: -1;
    in-out property <bool> copy-headers: true;
    in-out property <bool> query-running;
    in-out property <bool> query-has-run;
    in-out property <float> query-elapsed;
    in-out property <string> query-phase;
    in-out property <string> query-rows: "0";
    private property <duration> query-start-tick;
    callback query-started();
    query-started => {
        root.query-start-tick = animation-tick(); root.query-elapsed = 0;
        root.query-rows = "0"; root.query-running = true; root.query-has-run = true;
        root.query-phase = I18n.t("准备连接", "Connecting");
    }
    Timer {
        interval: 100ms; running: root.query-running;
        triggered => { root.query-elapsed = (animation-tick() - root.query-start-tick) / 1s; }
    }
    callback result-row-selected(int, bool, bool);
    callback result-cell-selected(int, int, bool, bool);
    callback result-column-at(float) -> int;
    callback result-column-selected(int, bool);
    in-out property <[DbObject]> hidden-objects;
    in-out property <bool> show-hidden;
    callback result-select-all();
    callback sort-result(int, bool);
    callback fit-result-column(int);
    callback measure-result-text(string) -> float;
    measure-result-text(value) => { column-metric.text = value; return column-metric.preferred-width / 1px; }
    column-metric := Text { visible: false; font-size: 12px; wrap: no-wrap; }
    callback action(string);
    callback remove-scope(int);
    callback scope-choice(int, int, bool);
    callback prefix-selected(int);
    callback filter-group();
    callback notify(string);
    notify(message) => { root.toast-text = message; root.toast-age = 0; }
    Timer {
        interval: 50ms;
        running: root.toast-age < 3000;
        triggered => { root.toast-age = min(3000, root.toast-age + 50); }
    }
    callback find-sql(string, int, bool) -> SearchMatch;
    callback new-sql();
    callback sql-selected(int);
    callback close-sql(int);
    callback sql-edited(string);
    callback file-loaded(string, string);
    callback document-saved(int, string, string);
    callback document-save-cancelled();
    callback request-document-save(int, string, string, string);
    callback result-update-begin(int) -> bool;
    callback result-update-end(int);
    callback reset-result-views();
    callback rename-sql(int, string);
    callback move-sql(int, int);
    callback close-documents();
    changed sql => { root.sql-edited(root.sql); }
    callback profile-selected(int);
    callback physical-selected(int);
    callback filter-objects();
    callback database-selected(string);
    callback schema-selected(string);
    callback table-selected(int);
    callback result-selected(int);
    callback change-page(int);
    callback language-changed();
    callback theme-selected(bool);


    in-out property <bool> light-checked: true;
    in-out property <bool> dark-checked;
    callback sync-theme-menu();
    sync-theme-menu => { root.light-checked = !Theme.dark; root.dark-checked = Theme.dark; }
    MenuBar {
        Menu {
            title: I18n.t("设置", "Settings");
            enabled: !root.save-prompt-open;
            MenuItem { title: I18n.t("连接配置…", "Connections…"); enabled: !root.busy; activated => { root.config-open = true; root.timeout-open = false; root.group-open = false; } }
            MenuItem { title: I18n.t("浏览范围…", "Browsing scope…"); enabled: !root.busy; activated => { root.action("scope-settings"); } }
            MenuItem { title: I18n.t("查询超时…", "Query timeout…"); enabled: !root.busy; activated => { root.timeout-input = root.timeout; root.timeout-open = true; root.config-open = false; root.group-open = false; } }
            Menu {
                title: I18n.t("主题", "Theme");
                light-theme := MenuItem { title: I18n.t("浅色（Light）", "Light"); checkable: true; checked <=> root.light-checked; enabled: !root.busy; activated => { root.theme-selected(false); root.sync-theme-menu(); } }
                dark-theme := MenuItem { title: I18n.t("深色（Dark）", "Dark"); checkable: true; checked <=> root.dark-checked; enabled: !root.busy; activated => { root.theme-selected(true); root.sync-theme-menu(); } }
            }
            Menu {
                title: I18n.t("语言", "Language");
                MenuItem { title: "简体中文"; checkable: true; checked: I18n.zh; enabled: !root.busy; activated => { I18n.zh = true; root.language-changed(); } }
                MenuItem { title: "English"; checkable: true; checked: !I18n.zh; enabled: !root.busy; activated => { I18n.zh = false; root.language-changed(); } }
            }
        }
    }
    VerticalLayout {
        x: 0px; y: 0px; width: 100%; height: 100%;
        spacing: 0px;
    body := Rectangle {
        vertical-stretch: 1;
        horizontal-stretch: 1;
        min-height: 0px;
        preferred-height: 0px;
        min-width: 0px;
        preferred-width: 0px;
        clip: true;
        HorizontalLayout {
            x: 0px; y: 0px; width: 100%; height: 100%; spacing: 0px;
        sidebar := Rectangle {
            width: root.sidebar-width.clamp(310px, min(650px, root.width - 680px));
            horizontal-stretch: 0;
            clip: true;
            background: Theme.panel;
            sidebar-layout := VerticalBox {
                padding: 4px;
                spacing: 3px;
                browser-area := VerticalBox {
                padding: 0px; spacing: 3px;
                height: !root.field-panel-hidden && (root.field-details.length > 0 || root.fields-loading) ? max(310px, (sidebar-layout.height - 13px) * (1 - root.field-ratio)) : sidebar-layout.height - 8px;
                HorizontalBox { padding: 0px;
                Caption { width: I18n.zh ? 42px : 78px; text: I18n.t("连接", "Connection"); }
                ComboBox { height: 24px; model: root.visible-profiles; current-index <=> root.physical-index; enabled: !root.busy; selected(value) => { root.physical-selected(self.current-index); } }
                }
                HorizontalBox { padding: 0px;
                Caption { width: I18n.zh ? 42px : 78px; text: I18n.t("库名", "Database"); }
                ComboBox { height: 24px; model: root.databases; current-index <=> root.database-index; enabled: root.connected && !root.busy; selected(value) => { root.database-selected(value); } }
                }
                HorizontalBox { padding: 0px;
                Caption { width: I18n.zh ? 42px : 78px; text: I18n.t("模式", "Schema"); }
                ComboBox { height: 24px; model: root.schemas; current-index <=> root.schema-index; current-value <=> root.schema; enabled: root.connected && !root.busy; selected(value) => { root.schema-selected(value); } }
                }
                HorizontalBox { padding: 0px;
                    Caption { width: I18n.zh ? 42px : 78px; text: I18n.t("过滤", "Filter"); }
                    ComboBox { height: 24px; model: root.prefix-options; current-index <=> root.prefix-index; enabled: root.connected && !root.busy; selected(value) => { root.prefix-selected(self.current-index); } }
                    CompactButton { text: I18n.t("删除", "Remove"); enabled: root.connected && root.prefix-index > 0 && root.prefix-index <= root.table-prefixes.length && !root.busy; clicked => { root.action("remove-prefix"); } }
                }
                HorizontalBox { padding: 0px;
                    spacing: 3px;
                    ObjectTab { text: "Table"; tab-style: true; selected: root.object-kind == 0; clicked => { root.object-kind = 0; root.filter-objects(); } }
                    ObjectTab { text: "View"; tab-style: true; selected: root.object-kind == 1; clicked => { root.object-kind = 1; root.filter-objects(); } }
                    ObjectTab { text: "MView"; tab-style: true; selected: root.object-kind == 2; clicked => { root.object-kind = 2; root.filter-objects(); } }
                    CompactButton { height: 24px; text: I18n.t("刷新", "Refresh"); enabled: root.connected && !root.busy; clicked => { root.action("refresh"); } }
                }
                HorizontalBox { padding: 0px; spacing: 3px;
                    LineEdit { height: 24px; text <=> root.object-search; placeholder-text: I18n.t("搜索表、视图、物化视图", "Search tables and views"); edited => { root.filter-objects(); } }
                    CompactButton { text: I18n.t("添加", "Add"); enabled: root.connected && root.object-search != "" && !root.busy; clicked => { root.action("add-prefix"); } }
                }
                object-menu := ContextMenuArea {
                    vertical-stretch: 1;
                    min-height: 100px;
                    Menu {
                        MenuItem { title: I18n.t("复制表结构", "Copy table structure"); enabled: !root.busy && root.table-index >= 0; activated => { root.action("copy-structure"); } }
                        MenuItem { title: root.show-hidden ? I18n.t("恢复显示", "Restore visibility") : I18n.t("隐藏", "Hide"); enabled: !root.busy && root.table-index >= 0; activated => { root.action(root.show-hidden ? "restore-object" : "hide-object"); } }
                        MenuItem { title: I18n.t("复制表名", "Copy object name"); enabled: !root.busy && root.table-index >= 0; activated => { root.action("copy-table"); } }
                        MenuItem { title: I18n.t("快速 LIMIT 10", "Quick LIMIT 10"); enabled: !root.show-hidden && !root.busy && root.table-index >= 0; activated => { root.action("quick-limit"); } }
                        MenuItem { title: I18n.t("快速 GROUP BY…", "Quick GROUP BY…"); enabled: !root.show-hidden && !root.busy && root.table-index >= 0; activated => { root.action("quick-group"); } }
                    }
                    DenseList {
                        model: root.tables; highlighted: root.table-changes;
                        enabled: !root.busy || root.fields-loading;
                        current-item <=> root.table-index;
                        current-item-changed(index) => { root.table-selected(index); }
                        item-double-clicked(index) => { root.action("copy-table"); }
                        item-pointer-event(index, event, pos) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.table-index = index; object-menu.show(pos); } }
                    }
                }
                }
                if !root.field-panel-hidden && (root.field-details.length > 0 || root.fields-loading): Rectangle {
                    height: 5px;
                    background: field-touch.has-hover || field-touch.pressed ? Theme.divider-hover : Theme.divider;
                    field-focus := FocusScope {
                        x: 0px; y: 0px; width: 100%; height: 100%;
                        accessible-role: slider;
                        accessible-label: I18n.t("调整字段区域高度", "Resize column panel");
                        key-pressed(event) => {
                            if event.text == Key.UpArrow { root.field-ratio = min(0.55, root.field-ratio + 0.03); return accept; }
                            if event.text == Key.DownArrow { root.field-ratio = max(0.12, root.field-ratio - 0.03); return accept; }
                            return reject;
                        }
                        field-touch := TouchArea {
                            mouse-cursor: ns-resize;
                            clicked => { field-focus.focus(); }
                            moved => { if self.pressed { root.field-ratio = (1 - (browser-area.height + self.mouse-y - self.pressed-y) / max(1px, sidebar-layout.height - 13px)).clamp(0.12, 0.55); } }
                        }
                    }
                }
                if !root.field-panel-hidden && (root.field-details.length > 0 || root.fields-loading): VerticalBox {
                    padding: 0px; spacing: 0px; vertical-stretch: 1; min-height: 80px;
                    Rectangle {
                        height: 24px; background: Theme.hover;
                        Text { x: 5px; width: parent.width * 0.6 - 10px; height: parent.height; text: I18n.t("字段", "Column"); color: Theme.heading; vertical-alignment: center; }
                        Text { x: parent.width * 0.6 + 5px; width: parent.width * 0.4 - 32px; height: parent.height; text: I18n.t("类型", "Type"); color: Theme.heading; vertical-alignment: center; }
                        IconButton { x: parent.width - 22px; y: 3px; width: 18px; height: 18px; icon-size: 12px; icon: @image-url("icons/close.svg"); accessible-label: I18n.t("隐藏字段区域", "Hide columns"); clicked => { root.field-panel-hidden = true; root.table-index = -1; } }
                    }
                    if root.fields-loading: Rectangle {
                        vertical-stretch: 1;
                        HorizontalLayout {
                            x: 0px; y: (parent.height - 24px) / 2; width: 100%; height: 24px;
                            spacing: 6px; alignment: center;
                            LoadingIndicator {}
                            Caption { height: 24px; text: I18n.t("加载中", "Loading"); horizontal-stretch: 0; }
                        }
                    }
                    if !root.fields-loading: Rectangle {
                        vertical-stretch: 1;
                        field-list := ListView {
                        width: 100%; height: 100%;
                        vertical-scrollbar-policy: always-off;
                        horizontal-scrollbar-policy: always-off;
                        for field[index] in root.field-details: Rectangle {
                            height: 22px;
                            background: Math.mod(index, 2) == 0 ? Theme.surface : Theme.panel;
                            accessible-role: list-item; accessible-label: field.name + ", " + field.datatype;
                            Text { x: 5px; width: parent.width * 0.6 - 10px; height: parent.height; text: field.name; color: field.added ? Theme.focus : Theme.text; vertical-alignment: center; overflow: elide; }
                            Text { x: parent.width * 0.6 + 5px; width: parent.width * 0.4 - 10px; height: parent.height; text: field.datatype; color: field.added ? Theme.focus : Theme.muted; vertical-alignment: center; overflow: elide; }
                        }
                    }
                        FadeScrollBar { x: parent.width - self.width; height: parent.height; content-height: field-list.content-height; value <=> field-list.content-y; }
                    }
                }
            }
        }
        sidebar-divider := Rectangle {
            width: 5px;
            horizontal-stretch: 0;
            background: side-touch.has-hover || side-touch.pressed ? Theme.divider-hover : Theme.divider;
            side-focus := FocusScope {
                x: 0px; y: 0px; width: 100%; height: 100%;
                accessible-role: slider;
                accessible-label: I18n.t("调整左侧栏宽度", "Resize sidebar");
                key-pressed(event) => {
                    if event.text == Key.LeftArrow { root.sidebar-width = max(310px, sidebar.width - 16px); return accept; }
                    if event.text == Key.RightArrow { root.sidebar-width = min(min(650px, root.width - 680px), sidebar.width + 16px); return accept; }
                    return reject;
                }
                side-touch := TouchArea {
                    mouse-cursor: ew-resize;
                    clicked => { side-focus.focus(); }
                    moved => { if self.pressed { root.sidebar-width = (sidebar.width + self.mouse-x - self.pressed-x).clamp(310px, min(650px, root.width - 680px)); } }
                }
            }
        }
        query-pane := Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            clip: true;
            pane-layout := VerticalLayout {
                x: 0px; y: 0px; width: 100%; height: 100%;
                padding: 4px;
                spacing: 0px;
                sql-area := Rectangle {
                    height: (max(0px, pane-layout.height - 13px) * root.split-ratio).clamp(220px, max(220px, pane-layout.height - 173px));
                    clip: true;
                    VerticalBox {
                        padding: 0px;
                        spacing: 0px;
                HorizontalLayout {
                    height: 24px;
                    spacing: 3px;
                    sql-tabs-scroll := ScrollView {
                        private property <int> active-tab: root.active-sql;
                        changed active-tab => {
                            let left = root.active-sql * 163px;
                            let right = left + 160px + (root.active-sql == root.sql-tabs.length - 1 ? 27px : 0px);
                            if left + self.content-x < 0px { self.content-x = -left; }
                            if right + self.content-x > self.visible-width { self.content-x = min(0px, self.visible-width - right); }
                        }
                        horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off;
                        horizontal-stretch: 1;
                        content-height: self.visible-height;
                        content-width: max(self.visible-width, tab-strip.preferred-width);
                        TouchArea { x: tab-strip.preferred-width; y: 0px; width: max(0px, parent.width - self.x); height: 24px; double-clicked => { if !root.document-saving && !root.save-prompt-open { root.new-sql(); } } }
                        tab-strip := HorizontalBox {
                            x: 0px; y: 0px; height: 24px;
                            padding: 0px; spacing: 3px; alignment: start;
                            for tab[index] in root.sql-tabs: Rectangle {
                                width: 160px; height: 24px;
                                accessible-role: button;
                                accessible-label: (tab.dirty ? "* " : "") + tab.title;
                                accessible-action-default => { root.sql-selected(index); }
                                background: index == root.active-sql ? Theme.selected : tab-touch.has-hover ? Theme.hover : Theme.panel;
                                border-width: 1px; border-color: Theme.border;
                                border-top-left-radius: 3px; border-top-right-radius: 3px;
                                Rectangle { x: 1px; y: parent.height - 1px; width: parent.width - 2px; height: 1px; background: parent.background; }
                                Text { x: 6px; width: parent.width - 26px; height: parent.height; text: (tab.dirty ? "* " : "") + tab.title; font-size: 12px; color: Theme.heading; vertical-alignment: center; overflow: elide; }
                                tab-focus := FocusScope {
                                    x: 0px; y: 0px; width: 100%; height: 100%; enabled: !root.document-saving && !root.save-prompt-open;
                                    key-pressed(event) => {
                                        if event.text == Key.Return || event.text == Key.Space { root.sql-selected(index); return accept; }
                                        if event.text == Key.Delete { root.close-sql(index); return accept; }
                                        return reject;
                                    }
                                    tab-menu := ContextMenuArea {
                                        Menu {
                                            MenuItem { title: I18n.t("重命名", "Rename"); activated => { root.rename-sql-index = index; root.rename-sql-text = tab.title; root.rename-sql-open = true; } }
                                        }
                                        tab-touch := TouchArea {
                                            private property <bool> dragging;
                                            mouse-cursor: self.pressed ? grabbing : default;
                                            moved => { if self.pressed && abs(self.mouse-x - self.pressed-x) > 5px { self.dragging = true; } }
                                            clicked => { if !self.dragging { tab-focus.focus(); root.sql-selected(index); } }
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { tab-menu.show({ x: self.mouse-x, y: self.mouse-y }); }
                                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { self.dragging = false; }
                                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.dragging {
                                                    root.move-sql(index, (index + round((self.mouse-x - self.pressed-x) / 163px)).clamp(0, root.sql-tabs.length - 1));
                                                }
                                            }
                                        }
                                    }
                                }
                                Text { x: parent.width - 20px; width: 18px; height: parent.height; text: "x"; font-size: 12px; color: close-touch.has-hover ? Theme.negative : Theme.muted; horizontal-alignment: center; vertical-alignment: center;
                                    accessible-role: button;
                                    accessible-label: I18n.t("关闭标签页", "Close tab");
                                    accessible-action-default => { if !root.document-saving && !root.save-prompt-open { root.close-sql(index); } }
                                    FocusScope {
                                        x: 0px; y: 0px; width: 100%; height: 100%; enabled: !root.document-saving && !root.save-prompt-open;
                                        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.close-sql(index); return accept; } return reject; }
                                        close-touch := TouchArea { enabled: !root.document-saving && !root.save-prompt-open; clicked => { root.close-sql(index); } }
                                    }
                                }
                                Tooltip { text: @markdown("\{tab.title}"); }
                            }
                            Rectangle {
                                width: 24px; height: 24px;
                                border-radius: 3px; border-width: 1px; border-color: Theme.border;
                                background: add-touch.has-hover ? Theme.hover : Theme.panel;
                                Text { width: 100%; height: 100%; text: "+"; color: Theme.heading; horizontal-alignment: center; vertical-alignment: center; }
                                accessible-role: button; accessible-label: I18n.t("新建 SQL", "New SQL");
                                accessible-action-default => { if !root.document-saving && !root.save-prompt-open { root.new-sql(); } }
                                FocusScope {
                                    width: 100%; height: 100%; enabled: !root.document-saving && !root.save-prompt-open;
                                    key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.new-sql(); return accept; } return reject; }
                                    add-touch := TouchArea { clicked => { root.new-sql(); } }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 3px;
                    Rectangle {
                        width: 24px;
                        VerticalLayout {
                            spacing: 3px; alignment: start;
                            IconButton { height: 24px; width: 24px; icon-size: 16px; icon: @image-url("icons/run.svg"); accessible-label: I18n.t("执行", "Run"); enabled: root.connected && !root.busy; clicked => { root.action("run"); } Tooltip { text: @markdown("\{I18n.t("执行", "Run")}"); } }
                            IconButton { height: 24px; width: 24px; icon-size: 16px; icon: @image-url("icons/cancel.svg"); accessible-label: I18n.t("取消", "Cancel"); enabled: root.busy; clicked => { root.action("cancel"); } Tooltip { text: @markdown("\{I18n.t("取消", "Cancel")}"); } }
                            IconButton { height: 24px; width: 24px; icon-size: 16px; icon: @image-url("icons/save.svg"); accessible-label: I18n.t("保存", "Save"); enabled: !root.busy; clicked => { root.action("save-document"); } Tooltip { text: @markdown("\{I18n.t("保存", "Save")}"); } }
                            IconButton { height: 24px; width: 24px; icon-size: 16px; icon: @image-url("icons/search.svg"); accessible-label: I18n.t("查找", "Find") + " (Ctrl+F)"; clicked => { sql-editor.open-find(); } Tooltip { text: @markdown("\{I18n.t("查找", "Find")} (Ctrl+F)"); } }
                            IconButton { height: 24px; width: 24px; icon-size: 16px; icon: @image-url("icons/import.svg"); accessible-label: I18n.t("导入", "Import"); enabled: !root.busy; clicked => { root.action("import"); } Tooltip { text: @markdown("\{I18n.t("导入", "Import")}"); } }
                            IconButton { height: 24px; width: 24px; icon-size: 16px; icon: @image-url("icons/export.svg"); accessible-label: I18n.t("导出", "Export"); enabled: !root.busy; clicked => { root.action("save-sql"); } Tooltip { text: @markdown("\{I18n.t("导出", "Export")}"); } }
                        }
                    }
                    editor-pane := VerticalLayout {
                        horizontal-stretch: 1;
                        min-height: 0px;
                        sql-editor := SqlEditor { save => { if !root.busy && !root.save-prompt-open { root.action("save-document"); } } find(needle, current, backward) => { return root.find-sql(needle, current, backward); } text <=> root.sql; read-only: (root.busy && root.active-document == root.query-document) || root.save-prompt-open; zh: I18n.zh; lines: root.sql-lines; highlighted-source: root.highlighted-sql; highlight(code) => { root.highlight(code); } }
                    }
                }
                    }
                }
                Rectangle {
                    height: 5px;
                    background: result-touch.has-hover || result-touch.pressed ? Theme.divider-hover : Theme.divider;
                    result-focus := FocusScope {
                        x: 0px; y: 0px; width: 100%; height: 100%;
                        accessible-role: slider;
                        accessible-label: I18n.t("调整结果区高度", "Resize results");
                        key-pressed(event) => {
                            if event.text == Key.UpArrow { root.split-ratio = (root.split-ratio - 16px / max(1px, pane-layout.height - 13px)).clamp(0.25, 0.75); return accept; }
                            if event.text == Key.DownArrow { root.split-ratio = (root.split-ratio + 16px / max(1px, pane-layout.height - 13px)).clamp(0.25, 0.75); return accept; }
                            return reject;
                        }
                        result-touch := TouchArea {
                            mouse-cursor: ns-resize;
                            clicked => { result-focus.focus(); }
                            moved => { if self.pressed { root.split-ratio = ((sql-area.height + self.mouse-y - self.pressed-y) / max(1px, pane-layout.height - 13px)).clamp(0.25, 0.75); } }
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 0px;
                    clip: true;
                    VerticalBox {
                        padding: 0px;
                        spacing: 3px;
                if root.result-names.length > 0: ScrollView {
                    height: result-tab-strip.preferred-width > self.width ? 40px : 24px;
                    vertical-scrollbar-policy: always-off;
                    content-height: 24px;
                    content-width: max(self.visible-width, result-tab-strip.preferred-width);
                    result-tab-strip := HorizontalBox {
                        x: 0px; y: 0px; padding: 0px; spacing: 3px; alignment: start; height: 24px;
                        for name[index] in root.result-names: ObjectTab {
                            text: name; width: 88px; horizontal-stretch: 0; enabled: !root.busy; tab-style: true;
                            selected: index == root.result-index;
                            clicked => { root.result-selected(index); }
                        }
                    }
                }
                HorizontalBox { padding: 0px; alignment: start;
                    IconButton { icon: @image-url("icons/copy.svg"); text: I18n.t("复制", "Copy"); framed: true; accessible-label: I18n.t("复制", "Copy"); enabled: !root.busy && root.result-index >= 0; clicked => { root.action("copy-all"); } Tooltip { text: @markdown("\{I18n.t("复制", "Copy")}"); } }
                    IconButton { icon: @image-url("icons/export.svg"); text: I18n.t("导出", "Export"); framed: true; accessible-label: I18n.t("导出", "Export"); enabled: !root.busy && root.result-index >= 0; clicked => { root.action("export"); } Tooltip { text: @markdown("\{I18n.t("导出", "Export")}"); } }
                    CheckBox { text: I18n.t("复制标题行", "Copy headers"); checked <=> root.copy-headers; }
                }
                DenseTable {
                    columns: root.result-columns; rows: root.result-rows; current-row <=> root.selected-row; vertical-stretch: 1;
                    sortable: !root.busy; ascending-text: I18n.t("ASC", "ASC"); descending-text: I18n.t("DESC", "DESC");
                    sort-column(column, descending) => { root.sort-result(column, descending); }
                    fit-column(column) => { root.fit-result-column(column); }
                    multi-select: true; selected-rows: root.selected-rows; selected-cells: root.selected-cells; row-offset: root.page * 100;
                    row-selected(index, shift, control) => { root.result-row-selected(index, shift, control); }
                    cell-selected(row, column, shift, control) => { root.result-cell-selected(row, column, shift, control); }
                    column-at(x) => { return root.result-column-at(x); }
                    column-selected(column, control) => { root.result-column-selected(column, control); }
                    select-all => { root.result-select-all(); }
                    copy-selection => { if !root.busy && root.selected-count > 0 { root.action("copy-row"); } }
                }
                HorizontalLayout {
                    height: 24px; spacing: 8px;
                    Rectangle {
                        min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; clip: true;
                        HorizontalLayout {
                            spacing: 4px;
                            if root.query-running: LoadingIndicator {}
                            query-info := Caption {
                                min-width: 0px; horizontal-stretch: 1; overflow: elide;
                                text: (root.query-has-run ? root.query-phase + " · " + I18n.t("耗时：", "Elapsed: ") + floor(root.query-elapsed) + "s" : "") + (root.query-has-run && (root.query-running ? root.query-rows != "0" : root.result-rows.length > 0) ? " · " + I18n.t("已加载 / 总行数 ", "Loaded / Total ") + (root.query-running ? root.query-rows : root.result-rows.length) + " / " + (root.query-running ? "—" : root.row-count) : "");
                                Tooltip { text: @markdown("\{query-info.text}"); }
                            }
                        }
                    }
                    HorizontalBox {
                        padding: 0px; alignment: start; horizontal-stretch: 0;
                        CompactButton { height: 24px; text: I18n.t("上一页", "Previous"); enabled: !root.busy && root.page > 0; clicked => { root.change-page(root.page - 1); } }
                        Caption { text: (root.pages > 0 ? root.page + 1 : 0) + " / " + root.pages; }
                        CompactButton { height: 24px; text: I18n.t("下一页", "Next"); enabled: !root.busy && root.page + 1 < root.pages; clicked => { root.change-page(root.page + 1); } }
                    }
                    Rectangle {
                        min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; clip: true;
                        background: root.failed ? Theme.error-background : Theme.status;
                        HorizontalBox {
                            padding: 2px; spacing: 4px;
                            result-status := Caption {
                                visible: root.failed;
                                min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; overflow: elide; horizontal-alignment: right;
                                text: root.failed ? root.status : "";
                                Tooltip { text: @markdown("\{result-status.text}"); }
                            }
                            if root.failed: CompactButton { text: I18n.t("复制错误", "Copy error"); clicked => { root.action("copy-error"); } }
                            Rectangle {
                                width: connection-state.preferred-width + 14px; horizontal-stretch: 0;
                                Rectangle { x: 0px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px; background: root.connected ? #26985c : #d74747; }
                                connection-state := Caption { x: 14px; width: self.preferred-width; height: parent.height; text: root.connected ? I18n.t("已连接", "Connected") : I18n.t("未连接", "Disconnected"); }
                            }
                        }
                    }
                }
                    }
                }
            }
        }
        }
    }
    }
    if (root.config-open || root.scopes-open || root.timeout-open || root.rename-sql-open || root.save-prompt-open || root.group-open): Rectangle {
        background: #60000000; TouchArea {}
    }
    if root.toast-age < 3000: Rectangle {
        x: (root.width - self.width) / 2; y: root.height - 100px;
        width: min(root.width - 80px, toast-label.preferred-width + 32px); height: 38px;
        background: Theme.toast-background; border-radius: 5px;
        opacity: min(1, (3000 - root.toast-age) / 300);
        animate opacity { duration: 50ms; }
        accessible-role: text; accessible-label: root.toast-text;
        toast-label := Text { x: 16px; width: parent.width - 32px; height: parent.height; text: root.toast-text; color: white; font-size: 12px; vertical-alignment: center; overflow: elide; }
    }
}


export component DialogWindow inherits Window {
    private property <int> scope-page;
    private property <int> scope-pages: max(1, ceil(root.browser-scopes.length / 10));
    private property <int> scope-page-count: min(10, max(0, root.browser-scopes.length - root.scope-page * 10));
    changed browser-scopes => { root.scope-page = root.scope-page.clamp(0, root.scope-pages - 1); }
    callback filter-options([string], string) -> [int];
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    in-out property <int> dialog-mode: 1;
    out property <string> window-title: root.dialog-mode == 1 ? I18n.t("连接配置", "Connections") : root.dialog-mode == 2 ? I18n.t("浏览范围", "Browsing scope") : root.dialog-mode == 3 ? I18n.t("查询超时", "Query timeout") : root.dialog-mode == 4 ? I18n.t("重命名", "Rename") : root.dialog-mode == 5 ? I18n.t("保存修改", "Save changes") + " · " + root.save-prompt-title : root.dialog-mode == 6 ? root.object-title : "SQL Desk";
    title: root.window-title;
    icon: @image-url("icons/app.png");
    preferred-width: root.dialog-mode == 0 ? 1280px : root.dialog-mode == 1 ? 640px : root.dialog-mode == 2 ? 460px : root.dialog-mode == 3 ? 340px : root.dialog-mode == 6 ? 480px : 420px;
    preferred-height: root.dialog-mode == 0 ? 850px : root.dialog-mode == 1 ? 496px : root.dialog-mode == 2 ? 256px + max(28px, root.scope-page-count * 28px) + (root.scope-pages > 1 ? 34px : 0px) : root.dialog-mode == 3 ? 100px : root.dialog-mode == 6 ? 132px + min(220px, max(66px, root.group-fields.length * 22px)) : 100px;
    min-width: root.dialog-mode == 0 ? 1050px : root.preferred-width;
    max-width: root.dialog-mode == 0 ? 100000px : root.preferred-width;
    min-height: root.dialog-mode == 0 ? 740px : root.preferred-height;
    max-height: root.dialog-mode == 0 ? 100000px : root.preferred-height;
    background: Theme.window;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 12px;

    in-out property <int> profile-index: -1;
    in-out property <string> profile-name;
    in-out property <int> engine;
    in-out property <string> host;
    in-out property <string> port: "5432";
    in-out property <string> database;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> tls: true;
    in-out property <bool> trust-server-certificate;
    in-out property <string> rename-sql-text;
    in-out property <string> group-search;
    in-out property <int> group-index: -1;
    in-out property <string> group-field;
    in-out property <string> timeout-input: "120";
    in-out property <int> scope-profile-index: -1;
    in-out property <int> scope-database-index: -1;
    in-out property <int> scope-schema-index: -1;
    in-out property <bool> config-open;
    in-out property <bool> scopes-open;
    in-out property <bool> timeout-open;
    in-out property <bool> rename-sql-open;
    in-out property <bool> save-prompt-open;
    in-out property <bool> group-open;
    in-out property <bool> busy;
    in-out property <bool> document-saving;
    in-out property <[string]> profiles;
    in-out property <[BrowserScope]> browser-scopes;
    in-out property <[ScopeChoice]> scope-profiles;
    in-out property <[ScopeChoice]> scope-databases;
    in-out property <[ScopeChoice]> scope-schemas;
    in-out property <[string]> scope-database-names;
    in-out property <[string]> scope-schema-names;
    in-out property <[StandardListViewItem]> group-fields;
    in-out property <int> rename-sql-index;
    in-out property <string> save-prompt-title;
    in-out property <string> object-title;
    in-out property <int> timeout: 120;
    in-out property <bool> connected;
    in-out property <bool> failed;
    in-out property <string> status;
    in-out property <string> toast-text;
    in-out property <int> toast-age: 3000;
    callback dialog-edited();
    callback action(string);
    callback profile-selected(int);
    callback scope-choice(int, int, bool);
    callback remove-scope(int);
    callback filter-group();
    callback rename-sql(int, string);
    callback notify(string);
    notify(message) => { root.toast-text = message; root.toast-age = 0; }
    Timer { interval: 50ms; running: root.toast-age < 3000; triggered => { root.toast-age = min(3000, root.toast-age + 50); } }
    if root.dialog-mode == 1: VerticalBox {
                padding: 16px; spacing: 12px;
                ScrollView {
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, connection-form.preferred-height);
                    connection-form := VerticalBox {
                            height: self.preferred-height; padding: 0px; spacing: 8px;
                            HorizontalBox { height: 32px; padding: 0px; spacing: 8px;
                            Caption { width: I18n.zh ? 90px : 132px; text: I18n.t("已保存连接", "Saved connection"); }
                            ComboBox { height: 32px;
                                model: root.profiles;
                                current-index <=> root.profile-index;
                                enabled: !root.busy;
                                selected(value) => { root.dialog-edited(); root.profile-selected(self.current-index); }
                            }
                            }
                            HorizontalBox { height: 32px; padding: 0px; spacing: 8px; Caption { width: I18n.zh ? 90px : 132px; text: I18n.t("连接名称", "Connection name"); } LineEdit { height: 32px; text <=> root.profile-name; placeholder-text: I18n.t("连接名称", "Connection name"); enabled: !root.busy; edited => { root.dialog-edited(); } } }
                            HorizontalBox { height: 32px; padding: 0px; spacing: 8px; Caption { width: I18n.zh ? 90px : 132px; text: I18n.t("数据库类型", "Database type"); } ComboBox { height: 32px; model: ["PostgreSQL", "Redshift"]; current-index <=> root.engine; enabled: !root.busy; selected(value) => { root.port = self.current-index == 1 ? "5439" : "5432"; root.dialog-edited(); } } }
                            HorizontalBox { height: 32px; padding: 0px; spacing: 8px; Caption { width: I18n.zh ? 90px : 132px; text: I18n.t("主机地址", "Host"); } LineEdit { height: 32px; text <=> root.host; placeholder-text: I18n.t("主机地址", "Host"); enabled: !root.busy; edited => { root.dialog-edited(); } } }
                            HorizontalBox { height: 32px; padding: 0px; spacing: 8px;
                                Caption { width: I18n.zh ? 90px : 132px; text: I18n.t("端口", "Port"); }
                                LineEdit { height: 32px; text <=> root.port; enabled: !root.busy; edited => { root.dialog-edited(); } }
                            }
                            HorizontalBox { height: 32px; padding: 0px; spacing: 8px; Caption { width: I18n.zh ? 90px : 132px; text: I18n.t("数据库", "Database"); } LineEdit { height: 32px; text <=> root.database; placeholder-text: I18n.t("数据库名称", "Database name"); enabled: !root.busy; edited => { root.dialog-edited(); } } }
                            HorizontalBox { height: 32px; padding: 0px; spacing: 8px; Caption { width: I18n.zh ? 90px : 132px; text: I18n.t("用户名", "Username"); } LineEdit { height: 32px; text <=> root.username; placeholder-text: I18n.t("用户名", "Username"); enabled: !root.busy; edited => { root.dialog-edited(); } } }
                            HorizontalBox { height: 32px; padding: 0px; spacing: 8px; Caption { width: I18n.zh ? 90px : 132px; text: I18n.t("密码", "Password"); } LineEdit { height: 32px; text <=> root.password; input-type: InputType.password; placeholder-text: I18n.t("密码", "Password"); enabled: !root.busy; edited => { root.dialog-edited(); } } }
                            CheckBox { height: 24px; text: I18n.t("启用 TLS 加密", "Enable TLS encryption"); checked <=> root.tls; enabled: !root.busy; toggled => { root.dialog-edited(); } }
                            CheckBox { height: 24px; text: I18n.t("信任服务器证书（跳过校验）", "Trust server certificate (skip verification)"); checked <=> root.trust-server-certificate; enabled: root.tls && !root.busy; toggled => { root.dialog-edited(); } }
                    }
                }
                VerticalBox { height: 56px; padding: 0px; spacing: 8px;
                    HorizontalBox { height: 24px; padding: 0px; spacing: 8px; alignment: center;
                        CompactButton { width: 104px; height: 24px; text: I18n.t("新建", "New"); enabled: !root.busy; clicked => { root.action("new-profile"); } }
                        CompactButton { width: 104px; height: 24px; text: I18n.t("保存", "Save"); enabled: !root.busy; clicked => { root.action("save-profile"); } }
                        CompactButton { width: 104px; height: 24px; text: I18n.t("删除", "Delete"); enabled: !root.busy && root.profile-index >= 0; clicked => { root.action("delete-profile"); } }
                    }
                    HorizontalBox { height: 24px; padding: 0px; spacing: 8px; alignment: center;
                        CompactButton { width: 104px; height: 24px; text: I18n.t("连接", "Connect"); enabled: !root.busy; primary: true; clicked => { root.action("connect"); } }
                        CompactButton { width: 104px; height: 24px; text: I18n.t("断开", "Disconnect"); enabled: !root.busy && root.connected; clicked => { root.action("disconnect"); } }
                        CompactButton { width: 104px; height: 24px; text: I18n.t("关闭", "Close"); clicked => { root.config-open = false; root.dialog-edited(); } }
                    }

                }
            }
    if root.dialog-mode == 2: VerticalBox {
                padding: 16px; spacing: 10px;
                HorizontalBox { height: 32px; padding: 0px; spacing: 8px;
                    Caption { width: I18n.zh ? 56px : 96px; text: I18n.t("连接", "Connection"); }
                    SearchCombo { model: root.profiles; current-index <=> root.scope-profile-index; enabled: !root.busy;
                        placeholder: I18n.t("请选择", "Select"); search-placeholder: I18n.t("搜索", "Search"); empty-text: I18n.t("无匹配项", "No matches"); accessible-label: I18n.t("连接", "Connection");
                        filter(model, query) => { return root.filter-options(model, query); }
                        selected(index) => { root.dialog-edited(); root.scope-choice(0, index, true); }
                    }
                }
                HorizontalBox { height: 32px; padding: 0px; spacing: 8px;
                    Caption { width: I18n.zh ? 56px : 96px; text: I18n.t("库名", "Database"); }
                    SearchCombo { model: root.scope-database-names; current-index <=> root.scope-database-index; enabled: !root.busy && root.scope-profile-index >= 0;
                        placeholder: I18n.t("请选择", "Select"); search-placeholder: I18n.t("搜索", "Search"); empty-text: I18n.t("无匹配项", "No matches"); accessible-label: I18n.t("库名", "Database");
                        filter(model, query) => { return root.filter-options(model, query); }
                        selected(index) => { root.dialog-edited(); root.scope-choice(1, index, true); }
                    }
                }
                HorizontalBox { height: 32px; padding: 0px; spacing: 8px;
                    Caption { width: I18n.zh ? 56px : 96px; text: I18n.t("模式", "Schema"); }
                    SearchCombo { model: root.scope-schema-names; current-index <=> root.scope-schema-index; enabled: !root.busy && root.scope-database-index >= 0;
                        placeholder: I18n.t("请选择", "Select"); search-placeholder: I18n.t("搜索", "Search"); empty-text: I18n.t("无匹配项", "No matches"); accessible-label: I18n.t("模式", "Schema");
                        filter(model, query) => { return root.filter-options(model, query); }
                        selected(index) => { root.dialog-edited(); root.scope-choice(2, index, true); }
                    }
                }
                HorizontalBox { height: 24px; padding: 0px; alignment: center;
                    CompactButton { text: I18n.t("添加", "Add"); enabled: !root.busy && root.scope-schema-index >= 0; clicked => { root.action("add-scope"); } }
                }
                Caption { text: I18n.t("已添加的组合", "Added combinations"); }
                VerticalBox {
                    height: max(28px, root.scope-page-count * 28px); padding: 0px; spacing: 0px;
                    for row in root.scope-page-count: HorizontalBox {
                        private property <int> scope-index: root.scope-page * 10 + row;
                        height: 28px; padding: 0px; spacing: 8px;
                        Text { horizontal-stretch: 1; min-width: 0px; text: root.browser-scopes[parent.scope-index].profile + " / " + root.browser-scopes[parent.scope-index].database + " / " + root.browser-scopes[parent.scope-index].schema; color: Theme.text; vertical-alignment: center; overflow: elide; }
                        CompactButton { width: 64px; text: I18n.t("删除", "Remove"); enabled: !root.busy; clicked => { root.remove-scope(parent.scope-index); } }
                    }
                }
                if root.scope-pages > 1: HorizontalBox { height: 24px; padding: 0px; spacing: 8px; alignment: center;
                    CompactButton { text: I18n.t("上一页", "Previous"); enabled: root.scope-page > 0; clicked => { root.scope-page -= 1; } }
                    Caption { text: (root.scope-page + 1) + " / " + root.scope-pages; }
                    CompactButton { text: I18n.t("下一页", "Next"); enabled: root.scope-page + 1 < root.scope-pages; clicked => { root.scope-page += 1; } }
                }
                HorizontalBox { height: 24px; padding: 0px; spacing: 8px; alignment: center;
                    CompactButton { height: 24px; text: I18n.t("保存", "Save"); enabled: !root.busy; primary: true; clicked => { root.action("save-scopes"); } }
                    CompactButton { height: 24px; text: I18n.t("取消", "Cancel"); enabled: !root.busy; clicked => { root.scopes-open = false; root.dialog-edited(); } }
                }
            }
    if root.dialog-mode == 3: VerticalBox {
                padding: 16px; spacing: 12px;
                HorizontalBox { height: 32px; padding: 0px; spacing: 8px; alignment: start;
                    Caption { text: I18n.t("超时（秒）", "Timeout (seconds)"); }
                    LineEdit { width: 104px; height: 32px; text <=> root.timeout-input; enabled: !root.busy; edited => { root.dialog-edited(); } }
                }
                HorizontalBox { height: 24px; padding: 0px; spacing: 8px; alignment: center;
                    CompactButton { text: I18n.t("保存", "Save"); primary: true; enabled: !root.busy; clicked => { root.action("save-timeout"); } }
                    CompactButton { text: I18n.t("关闭", "Close"); clicked => { root.timeout-open = false; root.dialog-edited(); } }
                }
            }
    if root.dialog-mode == 4: VerticalBox {
                padding: 16px; spacing: 12px;
                LineEdit { height: 32px; text <=> root.rename-sql-text; accepted => { root.rename-sql(root.rename-sql-index, root.rename-sql-text); } edited => { root.dialog-edited(); } }
                HorizontalBox { height: 24px; padding: 0px; spacing: 8px; alignment: end;
                    CompactButton { text: I18n.t("取消", "Cancel"); clicked => { root.rename-sql-open = false; root.dialog-edited(); } }
                    CompactButton { text: I18n.t("保存", "Save"); enabled: root.rename-sql-text != ""; clicked => { root.rename-sql(root.rename-sql-index, root.rename-sql-text); } }
                }
            }
    if root.dialog-mode == 5: VerticalBox {
                padding: 16px; spacing: 12px;
                Caption { text: I18n.t("有未保存的修改，是否保存？", "Save changes before closing?"); }
                HorizontalBox { height: 24px; padding: 0px; spacing: 8px; alignment: end;
                    CompactButton { height: 24px; text: I18n.t("保存", "Save"); primary: true; enabled: !root.busy; clicked => { root.action("prompt-save"); } }
                    CompactButton { height: 24px; text: I18n.t("放弃修改", "Discard"); enabled: !root.busy; clicked => { root.action("prompt-discard"); } }
                    CompactButton { height: 24px; text: I18n.t("取消", "Cancel"); clicked => { root.action("prompt-cancel"); } }
                }
            }
    if root.dialog-mode == 6: VerticalBox {
                padding: 16px; spacing: 10px;
                Caption { text: I18n.t("选择分组字段（COUNT(*)，降序）", "Group column (COUNT(*), descending)"); }
                LineEdit { height: 32px; text <=> root.group-search; placeholder-text: I18n.t("搜索字段", "Search columns"); edited => { root.dialog-edited(); root.filter-group(); } }
                DenseList {
                    model: root.group-fields; height: min(220px, max(66px, root.group-fields.length * 22px));
                    current-item <=> root.group-index;
                    current-item-changed(index) => { root.group-field = root.group-fields[index].text; root.dialog-edited(); }
                }
                HorizontalBox { height: 24px; padding: 0px; spacing: 8px; alignment: end;
                    CompactButton { height: 24px; text: I18n.t("生成 SQL", "Generate SQL"); enabled: root.group-field != ""; clicked => { root.action("generate-group"); } }
                    CompactButton { height: 24px; text: I18n.t("关闭", "Close"); clicked => { root.group-open = false; root.dialog-edited(); } }
                }
            }
    if root.toast-age < 3000: Rectangle {
        x: (root.width - self.width) / 2; y: root.height - 100px;
        width: min(root.width - 80px, toast-label.preferred-width + 32px); height: 38px;
        background: Theme.toast-background; border-radius: 5px;
        opacity: min(1, (3000 - root.toast-age) / 300);
        animate opacity { duration: 50ms; }
        accessible-role: text; accessible-label: root.toast-text;
        toast-label := Text { x: 16px; width: parent.width - 32px; height: parent.height; text: root.toast-text; color: white; font-size: 12px; vertical-alignment: center; overflow: elide; }
    }
}
