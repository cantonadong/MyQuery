import { ListView, VerticalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> destructive;
    callback clicked();
    height: 24px; width: max(48px, label.preferred-width + 24px);
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: Theme.control-radius; border-width: 1px;
    border-color: focus.has-focus ? Theme.focus : root.destructive && (root.primary || (root.enabled && touch.has-hover)) ? Theme.destructive : root.primary ? Theme.selected-border : Theme.border;
    background: root.destructive && (root.primary || (root.enabled && touch.has-hover)) ? Theme.destructive : root.enabled && touch.pressed ? Theme.selected : root.enabled && touch.has-hover ? Theme.hover : root.primary ? Theme.selected : Theme.surface;
    forward-focus: focus;
    accessible-role: button; accessible-label: root.text; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    label := Text { x: root.width <= 28px ? 2px : 8px; width: parent.width - 2 * self.x; height: 100%; text: root.text; font-size: 12px; color: root.destructive && (root.primary || (root.enabled && touch.has-hover)) ? white : Theme.text; opacity: root.enabled ? 1 : 0.4; horizontal-alignment: center; vertical-alignment: center; wrap: no-wrap; }
    focus := FocusScope {
        width: 100%; height: 100%; enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; } return reject; }
        touch := TouchArea { clicked => { focus.focus(); root.clicked(); } }
    }
}

export component PopupRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> selected;
    in property <bool> checked;
    callback activated();
    callback hovered();
    height: Theme.popup-row-height;
    border-radius: Theme.control-radius;
    background: root.enabled && root.selected ? Theme.selected : root.enabled && touch.has-hover ? Theme.hover : Theme.surface;
    accessible-role: list-item; accessible-label: root.text; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Image { x: 5px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: root.icon; colorize: Theme.text; opacity: root.enabled ? 1 : 0.4; }
    if root.checked: Path {
        x: 7px; y: (parent.height - 12px) / 2; width: 12px; height: 12px;
        viewbox-width: 12; viewbox-height: 12; stroke: Theme.text; stroke-width: 1.5px; fill: transparent;
        commands: "M 1 6 L 4 9 L 11 2";
    }
    Text { x: 26px; width: parent.width - 48px; height: 100%; text: root.text; font-size: 12px; color: Theme.text; opacity: root.enabled ? 1 : 0.4; vertical-alignment: center; overflow: elide; }
    touch := TouchArea { enabled: root.enabled; moved => { root.hovered(); } clicked => { root.activated(); } }
}

export struct PopupAction { text: string, enabled: bool, checked: bool, icon: image }

export component PopupMenu inherits TouchArea {
    in property <[PopupAction]> actions;
    in property <length> menu-width: 220px;
    callback activated(int);
    private property <Point> position;
    private property <int> highlighted: -1;
    changed actions => { root.highlighted = -1; }
    public function show(position: Point) { root.position = position; root.highlighted = -1; popup.show(); }
    public function close() { popup.close(); }
    function choose(index: int) {
        if index >= 0 && index < root.actions.length && root.actions[index].enabled {
            popup.close(); root.activated(index);
        }
    }
    pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.show({ x: self.mouse-x, y: self.mouse-y }); } }
    @children
    popup := PopupWindow {
        x: root.position.x; y: root.position.y;
        width: root.menu-width; height: root.actions.length * Theme.popup-row-height + 2 * Theme.popup-padding;
        close-policy: close-on-click-outside; forward-focus: popup-focus;
        Rectangle {
            background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.control-radius;
            popup-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape || event.text == Key.LeftArrow { popup.close(); return accept; }
                    if event.text == Key.DownArrow || event.text == Key.UpArrow { root.highlighted = root.highlighted < 0 ? (event.text == Key.DownArrow ? 0 : root.actions.length - 1) : mod(root.highlighted + root.actions.length + (event.text == Key.DownArrow ? 1 : -1), max(1, root.actions.length)); return accept; }
                    if event.text == Key.Return || event.text == Key.Space { root.choose(root.highlighted); return accept; }
                    return reject;
                }
                VerticalBox {
                    padding: Theme.popup-padding; spacing: 0px;
                    for action[index] in root.actions: PopupRow {
                        icon: action.icon; text: action.text; enabled: action.enabled; checked: action.checked; selected: root.highlighted == index;
                        hovered => { root.highlighted = index; }
                        activated => { root.choose(index); }
                    }
                }
            }
        }
    }
}

export component SelectBox inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: -1;
    in-out property <string> current-value: root.current-index >= 0 ? root.model[root.current-index] : "";
    in property <bool> enabled: true;
    callback selected(string);
    private property <int> highlighted;
    private property <length> scroll-y;
    private property <length> options-height: min(8, max(1, root.model.length)) * Theme.popup-row-height;
    height: 24px; min-width: 0px; horizontal-stretch: 1; vertical-stretch: 0;
    border-radius: Theme.control-radius; border-width: 1px;
    border-color: focus.has-focus ? Theme.focus : Theme.border;
    background: touch.has-hover && root.enabled ? Theme.hover : Theme.surface;
    forward-focus: focus;
    accessible-role: combobox; accessible-enabled: root.enabled; accessible-value: root.current-value;
    accessible-expandable: true; accessible-action-expand => { root.open(); }
    changed current-index => { root.current-value = root.current-index >= 0 ? root.model[root.current-index] : ""; }
    changed model => { root.current-value = root.current-index >= 0 ? root.model[root.current-index] : ""; }
    function open() { if root.enabled && root.model.length > 0 { root.highlighted = max(0, root.current-index); root.scroll-y = -max(0, root.highlighted - 7) * Theme.popup-row-height; popup.show(); } }
    function choose(index: int) { if root.enabled && index >= 0 && index < root.model.length { root.current-index = index; root.current-value = root.model[index]; popup.close(); focus.focus(); root.selected(root.current-value); } }
    Text { x: 8px; width: parent.width - 32px; height: 100%; text: root.current-value; font-size: 12px; color: Theme.text; opacity: root.enabled ? 1 : 0.4; vertical-alignment: center; overflow: elide; }
    Image { x: parent.width - 20px; y: (parent.height - 10px) / 2; width: 10px; height: 10px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.text; opacity: root.enabled ? 1 : 0.4; }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow { root.open(); return accept; } return reject; }
        touch := TouchArea { clicked => { focus.focus(); root.open(); } }
    }
    popup := PopupWindow {
        x: 0px; y: root.height; width: root.width; height: root.options-height + 2 * Theme.popup-padding;
        close-policy: close-on-click-outside; forward-focus: popup-focus;
        Rectangle {
            background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.control-radius;
            popup-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape { popup.close(); focus.focus(); return accept; }
                    if event.text == Key.Return || event.text == Key.Space { root.choose(root.highlighted); return accept; }
                    if event.text == Key.DownArrow || event.text == Key.UpArrow {
                        root.highlighted = (root.highlighted + (event.text == Key.DownArrow ? 1 : -1)).clamp(0, root.model.length - 1);
                        if root.highlighted * Theme.popup-row-height + root.scroll-y < 0px { root.scroll-y = -root.highlighted * Theme.popup-row-height; }
                        if (root.highlighted + 1) * Theme.popup-row-height + root.scroll-y > root.options-height { root.scroll-y = root.options-height - (root.highlighted + 1) * Theme.popup-row-height; }
                        return accept;
                    }
                    return reject;
                }
                ListView {
                    x: Theme.popup-padding; y: Theme.popup-padding; width: parent.width - 2 * Theme.popup-padding; height: root.options-height;
                    content-width: self.visible-width; content-y <=> root.scroll-y; horizontal-scrollbar-policy: always-off;
                    for value[index] in root.model: PopupRow {
                        text: value; selected: index == root.highlighted; checked: index == root.current-index;
                        hovered => { root.highlighted = index; }
                        activated => { root.choose(index); }
                    }
                }
            }
        }
    }
}
